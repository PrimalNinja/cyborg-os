10 ' CYBORGOS FOR THE PI FROM AN MSX WITH THE MSXPI CARTRIDGE
20 ' HELLO, PING, A STORE PUT AND GET. 1000, 2000, 3000 ARE THE PART TO COPY
30 DP=&H5A: CP=&H5B ' THE CARTRIDGE'S DATA AND CONTROL PORTS (VERIFY: MSXPI'S SOURCE)
40 CH=0:TY=1:ID=0:P$="COS1 MACHINE=MSX NAME=MSX MAX=256":GOSUB 1000:GOSUB 2000:PRINT "HELLO: ";R$
50 CH=0:TY=2:ID=1:P$="PING":GOSUB 1000:GOSUB 2000:PRINT "PING: ";R$
60 CH=0:TY=2:ID=2:P$="OPEN STORE":GOSUB 1000:GOSUB 2000:SC=VAL(MID$(R$,4))
70 CH=SC:TY=2:ID=3:P$="PUT MSX/HELLO.TXT"+CHR$(0)+"HELLO FROM AN MSX":GOSUB 1000:GOSUB 2000:PRINT "PUT: ";R$
80 CH=SC:TY=2:ID=4:P$="GET MSX/HELLO.TXT":GOSUB 1000:GOSUB 2000:PRINT "GET: ";R$
90 END
1000 ' SEND A FRAME
1010 L=LEN(P$):LL=L AND 255:LH=L\256
1020 S=CH+TY+ID+LL+LH:FOR I=1 TO L:S=S+ASC(MID$(P$,I,1)):NEXT:S=S AND 255
1030 B=165:GOSUB 3000:B=CH:GOSUB 3000:B=TY:GOSUB 3000:B=ID:GOSUB 3000:B=LL:GOSUB 3000:B=LH:GOSUB 3000
1040 FOR I=1 TO L:B=ASC(MID$(P$,I,1)):GOSUB 3000:NEXT:B=S:GOSUB 3000
1050 RETURN
2000 ' READ THE NEXT ANSWER FRAME
2010 GOSUB 3100:IF B<>165 THEN 2010
2020 GOSUB 3100:RC=B:GOSUB 3100:RT=B:GOSUB 3100:RI=B:GOSUB 3100:L=B:GOSUB 3100:L=L+256*B
2030 R$="":Z=0:FOR I=1 TO L:GOSUB 3100:IF B=0 THEN Z=1
2040 IF Z=0 AND LEN(R$)<200 THEN R$=R$+CHR$(B)
2050 NEXT:GOSUB 3100
2060 IF RT=5 OR RT=4 THEN 2010
2070 RETURN
3000 ' A BYTE OUT (THE HANDSHAKE ON THE CONTROL PORT: VERIFY)
3010 IF (INP(CP) AND 2)=0 THEN 3010
3020 OUT DP,B:RETURN
3100 ' A BYTE IN
3110 IF (INP(CP) AND 1)=0 THEN 3110
3120 B=INP(DP):RETURN
