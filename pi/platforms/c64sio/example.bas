10 REM CYBORGOS FOR THE PI FROM A C64: THE USER PORT RS-232 AT 1200 BAUD
20 REM HELLO, PING, THEN A STORE PUT AND GET. THE FRAME ROUTINE AT 1000 IS THE PART TO COPY
30 OPEN 2,2,3,CHR$(8)+CHR$(0):REM 1200 BAUD 8N1 (SEE THE README)
40 FOR I=1 TO 300:NEXT:REM THE KERNAL SETTLES
50 CH=0:TY=1:ID=0:P$="COS1 MACHINE=C64 NAME=C64 MAX=256":GOSUB 1000:GOSUB 2000:PRINT "HELLO: ";R$
60 CH=0:TY=2:ID=1:P$="PING":GOSUB 1000:GOSUB 2000:PRINT "PING: ";R$
70 CH=0:TY=2:ID=2:P$="OPEN STORE":GOSUB 1000:GOSUB 2000:PRINT "OPEN: ";R$
80 SC=VAL(MID$(R$,4)):REM THE STORE CHANNEL FROM "OK N"
90 CH=SC:TY=2:ID=3:P$="PUT C64/HELLO.TXT"+CHR$(0)+"HELLO FROM A C64":GOSUB 1000:GOSUB 2000:PRINT "PUT: ";R$
100 CH=SC:TY=2:ID=4:P$="GET C64/HELLO.TXT":GOSUB 1000:GOSUB 2000:PRINT "GET: ";R$
110 CLOSE 2:END
1000 REM SEND A FRAME: CH CHANNEL, TY TYPE (1 HELLO 2 REQ 4 DATA 6 CLOSE 7 CREDIT), ID, P$ PAYLOAD
1010 L=LEN(P$):LL=L-INT(L/256)*256:LH=INT(L/256)
1020 S=CH+TY+ID+LL+LH:FOR I=1 TO L:S=S+ASC(MID$(P$,I,1)):NEXT:S=S-INT(S/256)*256
1030 PRINT#2,CHR$(165)CHR$(CH)CHR$(TY)CHR$(ID)CHR$(LL)CHR$(LH)P$CHR$(S);
1040 RETURN
2000 REM READ THE NEXT FRAME: R$ ITS PAYLOAD TEXT (UP TO THE 0 IF THERE IS DATA), RC ITS CHANNEL
2010 GET#2,A$:IF A$<>CHR$(165) THEN 2010
2020 GET#2,A$:RC=ASC(A$+CHR$(0)):GET#2,A$:RT=ASC(A$+CHR$(0)):GET#2,A$:RI=ASC(A$+CHR$(0))
2030 GET#2,A$:L=ASC(A$+CHR$(0)):GET#2,A$:L=L+256*ASC(A$+CHR$(0))
2040 R$="":Z=0:FOR I=1 TO L:GET#2,A$:A=ASC(A$+CHR$(0)):IF A=0 THEN Z=1
2050 IF Z=0 AND LEN(R$)<200 THEN R$=R$+A$
2060 NEXT:GET#2,A$:REM THE CHECK (NOT VERIFIED HERE; PROTO.JS SAYS HOW)
2070 IF RT=5 OR RT=4 THEN 2010:REM EVENTS AND DATA SKIPPED: THIS EXAMPLE WANTS ANSWERS ONLY
2080 RETURN
