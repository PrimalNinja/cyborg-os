10 ' CYBORGOS FOR THE PI FROM A TRS-80 MODEL III / 4: THE RS-232 UART BY ITS PORTS, 9600 BAUD
20 ' HELLO, PING, A STORE PUT AND GET. LINES 1000 AND 2000 ARE THE PART TO COPY
30 OUT &HE8,0: OUT &HE9,&H77: OUT &HEA,&H6C ' 9600 BAUD, 8 BITS, NO PARITY (THE README SAYS WHAT TO VERIFY)
40 CH=0:TY=1:ID=0:P$="COS1 MACHINE=TRS80 NAME=TRS80 MAX=256":GOSUB 1000:GOSUB 2000:PRINT "HELLO: ";R$
50 CH=0:TY=2:ID=1:P$="PING":GOSUB 1000:GOSUB 2000:PRINT "PING: ";R$
60 CH=0:TY=2:ID=2:P$="OPEN STORE":GOSUB 1000:GOSUB 2000:SC=VAL(MID$(R$,4))
70 CH=SC:TY=2:ID=3:P$="PUT TRS80/HELLO.TXT"+CHR$(0)+"HELLO FROM A TRS-80":GOSUB 1000:GOSUB 2000:PRINT "PUT: ";R$
80 CH=SC:TY=2:ID=4:P$="GET TRS80/HELLO.TXT":GOSUB 1000:GOSUB 2000:PRINT "GET: ";R$
90 END
1000 ' SEND A FRAME: CH, TY, ID, P$
1010 L=LEN(P$):LL=L AND 255:LH=INT(L/256)
1020 S=CH+TY+ID+LL+LH:FOR I=1 TO L:S=S+ASC(MID$(P$,I,1)):NEXT:S=S AND 255
1030 B=165:GOSUB 3000:B=CH:GOSUB 3000:B=TY:GOSUB 3000:B=ID:GOSUB 3000:B=LL:GOSUB 3000:B=LH:GOSUB 3000
1040 FOR I=1 TO L:B=ASC(MID$(P$,I,1)):GOSUB 3000:NEXT:B=S:GOSUB 3000
1050 RETURN
2000 ' READ THE NEXT ANSWER FRAME: R$ ITS TEXT
2010 GOSUB 3100:IF B<>165 THEN 2010
2020 GOSUB 3100:RC=B:GOSUB 3100:RT=B:GOSUB 3100:RI=B:GOSUB 3100:L=B:GOSUB 3100:L=L+256*B
2030 R$="":Z=0:FOR I=1 TO L:GOSUB 3100:IF B=0 THEN Z=1
2040 IF Z=0 AND LEN(R$)<200 THEN R$=R$+CHR$(B)
2050 NEXT:GOSUB 3100 ' THE CHECK
2060 IF RT=5 OR RT=4 THEN 2010
2070 RETURN
3000 ' A BYTE OUT: WAIT FOR THE TRANSMITTER (STATUS BIT 6: VERIFY)
3010 IF (INP(&HEA) AND 64)=0 THEN 3010
3020 OUT &HEB,B:RETURN
3100 ' A BYTE IN: WAIT FOR ONE (STATUS BIT 7: VERIFY)
3110 IF (INP(&HEA) AND 128)=0 THEN 3110
3120 B=INP(&HEB):RETURN
