10 REM CYBORGOS FOR THE PI FROM AN ATARI 8-BIT: THE R: DEVICE (AN 850 OR A SOFTWARE HANDLER) AT 19200
20 REM HELLO, PING, A STORE PUT AND GET. 1000 AND 2000 ARE THE PART TO COPY
30 DIM P$(260),R$(260),A$(1)
40 OPEN #1,13,0,"R:":XIO 36,#1,14,0,"R:":XIO 40,#1,0,0,"R:":REM 19200 8N1, CONCURRENT MODE (SEE THE README)
50 CH=0:TY=1:ID=0:P$="COS1 MACHINE=ATARI NAME=ATARI MAX=256":GOSUB 1000:GOSUB 2000:PRINT "HELLO: ";R$
60 CH=0:TY=2:ID=1:P$="PING":GOSUB 1000:GOSUB 2000:PRINT "PING: ";R$
70 CH=0:TY=2:ID=2:P$="OPEN STORE":GOSUB 1000:GOSUB 2000:SC=VAL(R$(4))
80 CH=SC:TY=2:ID=3:P$="PUT ATARI/HELLO.TXT":P$(LEN(P$)+1)=CHR$(0):P$(LEN(P$)+1)="HELLO FROM AN ATARI":GOSUB 1000:GOSUB 2000:PRINT "PUT: ";R$
90 CH=SC:TY=2:ID=4:P$="GET ATARI/HELLO.TXT":GOSUB 1000:GOSUB 2000:PRINT "GET: ";R$
100 CLOSE #1:END
1000 REM SEND A FRAME
1010 L=LEN(P$):LL=L-INT(L/256)*256:LH=INT(L/256)
1020 S=CH+TY+ID+LL+LH:FOR I=1 TO L:S=S+ASC(P$(I,I)):NEXT I:S=S-INT(S/256)*256
1030 PUT #1,165:PUT #1,CH:PUT #1,TY:PUT #1,ID:PUT #1,LL:PUT #1,LH
1040 FOR I=1 TO L:PUT #1,ASC(P$(I,I)):NEXT I:PUT #1,S
1050 RETURN
2000 REM READ THE NEXT ANSWER FRAME
2010 GET #1,B:IF B<>165 THEN 2010
2020 GET #1,RC:GET #1,RT:GET #1,RI:GET #1,L:GET #1,B:L=L+256*B
2030 R$="":Z=0:FOR I=1 TO L:GET #1,B:IF B=0 THEN Z=1
2040 IF Z=0 AND LEN(R$)<200 THEN R$(LEN(R$)+1)=CHR$(B)
2050 NEXT I:GET #1,B
2060 IF RT=5 OR RT=4 THEN 2010
2070 RETURN
